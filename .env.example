# Copy this file to .env and fill in real values for local development.

# Postgres connection string. Matches the credentials in docker-compose.yml —
# only change this if you also change docker-compose.yml.
DATABASE_URL="postgresql://upresent:upresent@localhost:5433/upresent"

# Auth.js secret used to sign/encrypt session tokens.
# Required: login fails with MissingSecret while this is empty. Generate one
# with `npx auth secret` (writes it to .env.local, which Next.js also loads).
AUTH_SECRET=""

# Seeded super-admin account (created by `npm run db:seed`). Local dev only.
# The password is a static dev value: every seed run (re)sets the super-admin's
# password to exactly this value, so it is always the one to log in with. Never
# reuse it, or run the seed, anywhere real accounts live.
SEED_SUPER_ADMIN_EMAIL="super-admin@upresent.local"
SEED_SUPER_ADMIN_PASSWORD="upresent-dev-password"
