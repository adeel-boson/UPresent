generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Only SUPER_ADMIN is usable today. ORG_ADMIN and HOST are declared here
// because the login/session model needs to know the full set of roles it
// will eventually carry, but nothing in this ticket issues those roles —
// see CONTEXT.md for the role definitions.
enum Role {
  SUPER_ADMIN
  ORG_ADMIN
  HOST
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  hashedPassword String
  role           Role
  emailVerified  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}
